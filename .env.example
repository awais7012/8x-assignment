# Copy to .env and fill in. Nothing here is committed.

# --- Database ---------------------------------------------------------------
# Neon / Supabase / any Postgres. Keep sslmode=require for hosted providers.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# --- Clerk auth -------------------------------------------------------------
# Without these the app still renders the signed-out landing page, but the
# workspace is unavailable. Create an app at https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/quiz"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/quiz"

# --- Generation providers ---------------------------------------------------
# Primary image model via Google AI Studio (free tier). Optional: if unset,
# Pollinations serves alone and the UI says so.
# Model names move fast - check https://ai.google.dev/gemini-api/docs/models
GEMINI_API_KEY=""
GEMINI_IMAGE_MODEL="gemini-3.1-flash-image-preview"

# Fallback image + all video: Pollinations, no key required.
POLLINATIONS_IMAGE_MODEL="flux"
POLLINATIONS_VIDEO_MODEL="veo-3-fast"

# --- Vercel Blob (optional) -------------------------------------------------
# Used to persist Gemini's inline image bytes. If unset, inline results are
# stored as data URLs in Postgres instead.
BLOB_READ_WRITE_TOKEN=""
